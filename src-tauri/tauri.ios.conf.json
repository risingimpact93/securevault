{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SecureVault",
  "version": "0.5.1",
  "identifier": "com.securevault.ios",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SecureVault",
        "width": 430,
        "height": 932,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "iOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.ios.plist"
    }
  },
  "build": {
    "beforeBuildCommand": "npm run build && sh scripts/ios-prepare.sh"
  }
}
